# Sao chép file này thành .env rồi điền giá trị. Dòng để trống = dùng mặc định.
# Biến đã đặt sẵn trong môi trường (shell) sẽ được ưu tiên hơn giá trị trong .env.

# ===== Chọn provider =====
# openai    = model tự host qua API chuẩn OpenAI (vLLM, Ollama, LM Studio, gateway Bifrost/LiteLLM...)
# anthropic = Claude qua Anthropic SDK
# Để trống: tên model bắt đầu bằng "claude" -> anthropic, còn lại -> openai
T2SQL_PROVIDER=openai

# ===== Model tự host (T2SQL_PROVIDER=openai) =====
# URL gốc của API, có hoặc không có /v1 đều được. Ví dụ: http://10.100.110.251:30301/v1
LLM_BASE_URL=
# Key của gateway (để trống nếu server không yêu cầu)
LLM_API_KEY=
# Tên model đúng như GET {LLM_BASE_URL}/models trả về, ví dụ SDS-AI/softdream
T2SQL_MODEL=
# 0 = ổn định, lặp lại được khi chấm điểm
T2SQL_TEMPERATURE=0
# Số token tối đa mỗi lời gọi (gồm cả phần suy nghĩ). Vượt context của model thì tự giảm dần.
T2SQL_MAX_TOKENS=8192
# Model suy nghĩ lâu: dùng streaming (T2SQL_STREAM=1). T2SQL_TIMEOUT = số giây chờ token đầu tiên / giữa hai token,
# T2SQL_MAX_WAIT = tổng số giây tối đa cho một lời gọi, T2SQL_RETRIES = số lần thử lại khi timeout / 429 / 5xx
T2SQL_TIMEOUT=600
T2SQL_MAX_WAIT=1800
T2SQL_STREAM=1
# Suy nghĩ (reasoning) của model: off = tắt, low | medium | high, trống = mặc định của model.
# Gửi qua tham số reasoning_effort. Tham số riêng khác của server đặt ở T2SQL_EXTRA_BODY (JSON).
T2SQL_REASONING=off
T2SQL_EXTRA_BODY=
T2SQL_RETRIES=1
# Số câu chạy song song khi chạy evaluate.py (giảm nếu server tự host bị quá tải)
T2SQL_WORKERS=4

# ===== Claude (T2SQL_PROVIDER=anthropic) =====
ANTHROPIC_API_KEY=
# Trống = https://api.anthropic.com
ANTHROPIC_BASE_URL=
# Ví dụ: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5 (dùng chung biến T2SQL_MODEL ở trên)
# low | medium | high | xhigh | max. Tự bỏ qua với model không hỗ trợ.
T2SQL_EFFORT=medium
# 1 = model từ chối vì lý do an toàn thì tự chạy lại trên model dự phòng (chỉ model Claude mới). 0 = tắt.
T2SQL_FALLBACKS=1

# ===== Database (chỉ hỗ trợ ClickHouse) =====
# ClickHouse của công ty (database hddt). Điền URL vào T2SQL_DATABASE_URL_CONGTY rồi chạy: python connect_company.py
#   (kiểm tra kết nối, quyền, giới hạn; --init tạo bộ dữ liệu khởi đầu cho database mới)
#   clickhouse://<tài khoản>:<mật khẩu>@<host>:8123/<database>?single_user=1      HTTP
#   clickhouses://<tài khoản>:<mật khẩu>@<host>:8443/<database>?single_user=1     HTTPS
# single_user=1: dùng đúng tài khoản này cho mọi vai trò (không đổi thành <tài khoản>_<vai trò>).
# Mật khẩu có ký tự đặc biệt (@ : / # %) phải mã hóa URL, ví dụ @ -> %40. Tên database phải có thư mục datasets/<tên>/.
# Chạy ngoài Docker nếu máy chủ là máy local: dùng 127.0.0.1 (không dùng localhost, trên Windows chậm 5s do IPv6).
T2SQL_DATABASE_URL_CONGTY=
# Database mặc định của CLI / evaluate.py / app (thường đặt giống T2SQL_DATABASE_URL_CONGTY).
# Thêm database khác vào ô chọn Database của app: đặt thêm T2SQL_DATABASE_URL_<TÊN>.
T2SQL_DATABASE_URL=
# Timeout (giây) cho mỗi truy vấn do model sinh ra (database lớn cần dài hơn 5s)
T2SQL_QUERY_TIMEOUT=30
# Lưu đệm schema (giá trị mẫu cột) trong .cache/, số giờ; 0 = tắt
T2SQL_SCHEMA_CACHE_HOURS=24

# ===== docker compose =====
APP_PORT=8501
# Tùy chọn: URL ClickHouse cho app bên trong Docker; trống thì dùng T2SQL_DATABASE_URL_CONGTY.
T2SQL_DATABASE_URL_DOCKER=

# ===== Giao diện web: vai trò đặc quyền =====
# Mặc định giao diện chỉ hiện vai trò hạn chế (analyst: che dữ liệu cá nhân); vai trò admin bị ẩn.
# T2SQL_ADMIN_PASSWORD: nhập đúng mật khẩu ở thanh bên (Chế độ quản trị) thì thấy thêm admin.
# T2SQL_ALLOW_ADMIN=1: luôn hiện mọi vai trò (chỉ dùng khi chạy trên máy cá nhân, không dùng khi mở cho người khác).
T2SQL_ADMIN_PASSWORD=
T2SQL_ALLOW_ADMIN=

# ===== Model của người khác qua MCP (xem docs/huong_dan_ket_noi_model_mcp.md) =====
# Hồ sơ model tạo bằng trang cấu hình (link mời). Dùng hồ sơ này cho CLI / evaluate.py / app: T2SQL_LLM_PROFILE=<tên hồ sơ>
T2SQL_LLM_PROFILE=
# Địa chỉ công khai của ứng dụng (ví dụ địa chỉ ngrok), để link mời in ra đầy đủ.
T2SQL_PUBLIC_URL=
# Chỉ chấp nhận MCP server ở các host này (cách nhau dấu phẩy); trống = chấp nhận mọi host hợp lệ.
T2SQL_MCP_ALLOWED_HOSTS=
# 1 = cho phép địa chỉ loopback (chỉ khi thử với server giả trên máy mình).
T2SQL_MCP_ALLOW_LOCAL=
# Đường dẫn file hồ sơ (chứa token của người khác, nằm ngoài git). Mặc định .cache/llm_profiles.json
T2SQL_PROFILES_FILE=

# ===== Máy chủ MCP (ask_data), xem docs/khao_sat_dong_goi_mcp.md =====
# Chạy: python -m t2sql.mcp_server serve --port 8780 ; tạo token: python -m t2sql.mcp_server token-create --label <tên>
T2SQL_MCP_PORT=8780
# Kho token (lưu băm, ngoài git). Mặc định .cache/mcp_tokens.json
T2SQL_MCP_TOKENS_FILE=
# Số ngày hiệu lực mặc định của token mới
T2SQL_MCP_TOKEN_DAYS=30
# Hạn chót mỗi lệnh gọi (giây): đặt thấp hơn cửa sổ gọi công cụ của client (WeKnora: 60 giây)
T2SQL_MCP_DEADLINE_S=25
T2SQL_MCP_DEDUPE_TTL_S=120
# Giới hạn tải (không xếp hàng, đầy thì từ chối ngay)
T2SQL_MCP_MAX_CONCURRENT=2
T2SQL_MCP_MAX_PER_USER=1
T2SQL_MCP_RATE_PER_MIN=20
# Host được phép khi chạy sau Tailscale Serve hoặc đường hầm (cách nhau dấu phẩy), ví dụ <máy>.<tailnet>.ts.net
T2SQL_MCP_ALLOWED_HOSTS=
# Cấu hình pipeline cho kênh MCP (mặc định production)
T2SQL_MCP_CONFIG=
